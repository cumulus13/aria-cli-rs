[package]
name = "aria-cli"
version = "2.0.3"
edition = "2021"
rust-version = "1.86"
authors = ["Hadi Cahyadi <cumulus13@gmail.com>"]
description = "A robust, professional CLI to send URLs to Aria2 (with headers/cookies), monitor, and manage downloads via JSON-RPC."
homepage = "https://github.com/cumulus13/aria-cli-rs"
repository = "https://github.com/cumulus13/aria-cli-rs"
documentation = "https://docs.rs/aria-cli"
readme = "README.md"
license = "MIT"
keywords = ["aria2", "download-manager", "cli", "jsonrpc", "tui"]
categories = ["command-line-utilities"]
exclude = [".github/", "screenshots/"]

[[bin]]
name = "aria-cli"
path = "src/main.rs"

[dependencies]
# --- CLI ---
clap = { version = "4", features = ["derive", "color", "env"] }
clap-color-help = "0.1.3"
clap-version-flag = "1.0.7"

# --- Terminal colors (hex/RGB) ---
make_colors = "1.0.2"

# --- Config file discovery/reading (.env/.ini/.toml/.json/.yml auto-discovery) ---
config-get = "0.1.7"

# --- ASCII charts for live monitor ---
rasciichart = "0.2.17"

# --- HTTP / JSON-RPC ---
reqwest = { version = "0.12", default-features = false, features = ["blocking", "json", "rustls-tls"] }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
url = "2"

# --- Terminal control (live redraw, screen clear, raw-mode key polling) ---
crossterm = "0.28"

# --- Clipboard ("c" URL shortcut) ---
# default-features off: we only paste text, and arboard's default "image-data"
# feature drags in the `image` crate (needs rustc 1.88+) for no benefit here.
# "wayland-data-control" keeps clipboard access working on pure-Wayland Linux
# (no XWayland) instead of silently falling back to X11-only support.
arboard = { version = "3", default-features = false, features = ["wayland-data-control"] }

# --- Ctrl+C handling for monitor / interactive loops ---
ctrlc = "3"

# --- Errors ---
thiserror = "1"

# --- Logging (opt-in via --debug) ---
log = "0.4"
env_logger = "0.11"

[profile.release]
opt-level = 3
lto = true
codegen-units = 1
strip = true
panic = "abort"

[profile.dev]
opt-level = 0
